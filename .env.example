# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-flash-latest)
LLM_MODEL=gemini-flash-latest

# Web App public URL (for Telegram Mini App buttons)
# In production, use your HTTPS domain or ngrok URL (e.g. https://yourdomain.com)
WEBAPP_URL=http://localhost:8000

# Schedule: 2 times per week (Wednesday & Sunday at 10:00)
CRON_SCHEDULE_DAYS=wed,sun
CRON_SCHEDULE_HOUR=10
CRON_SCHEDULE_MINUTE=0

# Relevance Score Threshold (0-100)
MIN_RELEVANCE_SCORE=40

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/helsinki_gigs.db
